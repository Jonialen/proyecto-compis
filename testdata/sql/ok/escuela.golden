=== metadata.txt ===
# Compiscript SQL metadata v1
TABLE estudiantes
COLUMN id INT PRIMARY_KEY NOT_NULL
COLUMN nombre VARCHAR(30) NOT_NULL
COLUMN edad INT
COLUMN promedio FLOAT
COLUMN activo BOOLEAN
COLUMN nacimiento DATE
END
TABLE cursos
COLUMN id INT PRIMARY_KEY NOT_NULL
COLUMN nombre VARCHAR(40) NOT_NULL
COLUMN creditos INT NOT_NULL
END
TABLE inscripciones
COLUMN estudiante_id INT NOT_NULL
COLUMN curso_id INT NOT_NULL
COLUMN nota FLOAT
COLUMN fecha DATE
END
