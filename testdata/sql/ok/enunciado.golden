=== metadata.txt ===
# Compiscript SQL metadata v1
TABLE estudiantes
COLUMN id INT PRIMARY_KEY NOT_NULL
COLUMN nombre VARCHAR(50) NOT_NULL
COLUMN edad INT NOT_NULL
END
TABLE cursos
COLUMN id INT PRIMARY_KEY NOT_NULL
COLUMN nombre VARCHAR(50) NOT_NULL
END
TABLE inscripciones
COLUMN estudiante_id INT NOT_NULL
COLUMN curso_id INT NOT_NULL
END
INDEX idx_edad ON estudiantes(edad)
