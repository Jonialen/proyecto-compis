# Compiscript SQL metadata v1
TABLE estudiantes
COLUMN id INT PRIMARY_KEY NOT_NULL
COLUMN nombre VARCHAR(50) NOT_NULL
COLUMN edad INT
COLUMN promedio FLOAT
COLUMN activo BOOLEAN
COLUMN nacimiento DATE
END
TABLE cursos
COLUMN id INT PRIMARY_KEY NOT_NULL
COLUMN nombre VARCHAR(40)
END
