=== metadata.txt ===
# Compiscript SQL metadata v1
TABLE clientes
COLUMN id INT PRIMARY_KEY NOT_NULL
COLUMN nombre VARCHAR(20) NOT_NULL
COLUMN ciudad VARCHAR(20)
COLUMN registro DATE
COLUMN vip BOOLEAN
END
TABLE productos
COLUMN id INT PRIMARY_KEY NOT_NULL
COLUMN nombre VARCHAR(20) NOT_NULL
COLUMN categoria VARCHAR(15)
COLUMN precio FLOAT NOT_NULL
COLUMN stock INT
END
TABLE pedidos
COLUMN id INT PRIMARY_KEY NOT_NULL
COLUMN cliente_id INT NOT_NULL
COLUMN fecha DATE NOT_NULL
COLUMN estado VARCHAR(10) NOT_NULL
END
TABLE detalle
COLUMN pedido_id INT NOT_NULL
COLUMN producto_id INT NOT_NULL
COLUMN cantidad INT NOT_NULL
COLUMN descuento FLOAT
END
INDEX idx_cli_ciudad ON clientes(ciudad)
INDEX idx_ped_cliente ON pedidos(cliente_id)
INDEX idx_prod_precio ON productos(precio)
